{
  "manifest_version": 3,
  "name": "Vice Blind: GTA VI Spoiler Blocker",
  "short_name": "Vice Blind",
  "version": "1.0.0",
  "description": "Hides GTA VI posts, videos, thumbnails and headlines on every site, so PC players can wait for the PC version spoiler-free.",
  "author": "ROCMINE",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Vice Blind",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/api.js",
        "shared/settings.js",
        "shared/keywords.js",
        "content/sites.js",
        "content/curtain.js",
        "content/content-css.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/Unbounded-latin.woff2", "assets/fonts/JetBrainsMono-latin.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "121"
}
